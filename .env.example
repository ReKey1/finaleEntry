# Copy to .env for local development with `netlify dev`.
# .env is gitignored. In production set these under
# Site configuration -> Environment variables in the Netlify dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> Secret keys. Starts with sb_secret_.
#
# It must be a secret key, not a publishable one. Secret keys bypass row
# level security; the responses table has no policies, so a publishable key
# (sb_publishable_...) has every insert denied and the form silently stops
# working. The function checks for this and says so in the logs.
#
# Only netlify/functions/submit.mjs reads it, and it is never sent to the
# browser. Do not put it in public/ or in any client-side file.
SUPABASE_SECRET_KEY=
