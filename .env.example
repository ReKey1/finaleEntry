# Copy to .env for local development with `netlify dev`.
# .env is gitignored. In production set these under
# Site configuration -> Environment variables in the Netlify dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co

# Settings -> API -> service_role. This key bypasses row level security.
# It is only ever read by netlify/functions/submit.mjs and is never sent
# to the browser. Do not put it in public/ or in any client-side file.
SUPABASE_SERVICE_ROLE_KEY=
